---
import { profile } from '@data/data';
---
<header class="flex flex-col justify-center gap-3 pt-6 sm:pt-10">
    <a href="/" title="Go back to homepage" class="">
        <img
          src={profile.image}
          srcset={`${profile.image320} 320w, ${profile.image800} 800w`}
          sizes="(max-width: 640px) 20vw, 128px"
          width="128" height="128"
          loading="lazy"
          decoding="async"
          class="mx-auto w-24 rounded-full object-cover overflow-hidden sm:w-32" alt={profile.name} title={profile.name} />
        <h3 class="text-center text-xl font-bold sm:text-2xl">
            {profile.username}
            <br />{profile.bio}
        </h3>
    </a>
</header>