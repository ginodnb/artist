---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
---

<Layout className='min-h-screen bg-[#070F2B] text-white' forceDark={true}>
  <Header />

  <main class="flex min-h-[55vh] items-start justify-center px-4 py-4 sm:py-8">
    <div class="flex w-full max-w-[680px] flex-col items-center gap-4">
      <div class="w-full rounded-lg border border-white/20 bg-[#0b1639]/95 px-2 py-2.5 shadow-lg shadow-black/35 sm:px-3 sm:py-4">
        <h1 class="mb-1 text-center text-base font-black tracking-[0.08em] text-white sm:text-xl">
          Gino Presents: The Ghost EP Release Party - Cambridge, Kiki Club
        </h1>
        <p class="text-center text-[11px] leading-relaxed text-blue-100/90 sm:text-sm">
          Gino, Trimer, Kefrennnn (IT), Lottie (AUS) plus guests, for one night of Drum and Bass (and getting like that) in Cambridge
        </p>
      </div>

      <a
        href="https://www.skiddle.com/whats-on/Cambridge/Kiki-Cambridge/Gino-Presents-The-Ghost-EP-Release-Party/42623601/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-[88px] w-full items-center gap-4 rounded-lg border border-yellow-400/40 bg-[#111c3f] p-4 text-white shadow-[0_0_0_1px_rgba(255,255,255,0.04),0_8px_24px_rgba(0,0,0,0.35)] transition-transform duration-200 ease-in-out hover:scale-[1.02]"
      >
        <span class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-lg bg-yellow-300/20 text-2xl font-black text-yellow-300">
          🎟️
        </span>
        <h3 class="text-lg font-semibold tracking-wide text-white sm:text-xl">
          Get tickets for Cambridge Party 29.08.26
        </h3>
      </a>
    </div>
  </main>
</Layout>
