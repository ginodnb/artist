---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';

const ticketHref = '/tour-dates';
---

<Layout className='min-h-screen bg-[#070F2B] text-white'>
  <Header />

  <main class="flex min-h-[55vh] items-center justify-center px-4 py-4 sm:py-10">
    <a
      href="https://skiddle.com/whats-on/Cambridge/Kiki-Cambridge/Gino-Presents-The-Ghost-EP-Release-Party/42623601/"
      class="group flex w-full max-w-[620px] items-center justify-between rounded-2xl border border-white/15 bg-gradient-to-r from-[#0b3b66] via-[#1b4f8b] to-[#0e214f] px-6 py-5 shadow-2xl shadow-black/35 transition-all duration-200 hover:-translate-y-1 hover:scale-[1.01] sm:px-8 sm:py-6"
    >
      <span class="text-2xl font-black uppercase tracking-[0.22em] text-white sm:text-3xl">
        Cambridge
      </span>
      <span class="ml-4 rounded-full border border-yellow-300/50 bg-yellow-300/15 px-4 py-2 text-base font-semibold uppercase tracking-[0.24em] text-yellow-300 transition-colors duration-200 group-hover:bg-yellow-300 group-hover:text-[#07111f] sm:text-lg">
        tickets
      </span>
    </a>
  </main>
</Layout>
