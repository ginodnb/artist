---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
---

<Layout className='min-h-screen bg-[#070F2B] text-white' forceDark={true}>
  <Header />

  <main class="flex min-h-[55vh] items-center justify-center px-4 py-4 sm:py-10">
    <div class="w-full max-w-[760px] rounded-2xl border border-white/15 bg-[#0b1639]/90 px-4 py-5 shadow-2xl shadow-black/40 sm:px-6 sm:py-6">
      <h1 class="mb-3 text-2xl font-black tracking-[0.08em] text-white sm:text-3xl">
        Gino Presents: The Ghost EP Release Party - Cambridge, Kiki Club
      </h1>
      <p class="mb-5 text-sm leading-relaxed text-blue-100/90 sm:text-base">
        Gino, Trimer, Kefrennnn (IT), Lottie (AUS) plus guests, for one night of Drum and Bass (and getting like that) in Cambridge
      </p>

      <!-- Start Ticket Box 42623601 -->
      <div id="ticketbox_ph_42623601">
        <p>
          To buy tickets for this event please visit our events page:
          <a href="https://www.skiddle.com/whats-on/Cambridge/Kiki-Cambridge/Gino-Presents-The-Ghost-EP-Release-Party/42623601/">
            <strong>Gino Presents: The Ghost EP Release Party tickets from Skiddle</strong>
          </a>.
        </p>
      </div>
      <script type="text/javascript" is:inline>
        (function () {
          var po = document.createElement('script');
          po.type = 'text/javascript';
          po.async = true;
          po.src = 'https://www.skiddle.com/infofeed/ticketpage.php?ilid=42623601;type=embedded';
          var s = document.getElementsByTagName('script')[0];
          s.parentNode.insertBefore(po, s);
        })();
      </script>
      <p style="margin-top:0;font-size:8pt;line-height:13px;">
        <a href="https://www.skiddle.com/" style="color:#666">Ticket sales powered by Skiddle</a>
      </p>
      <!-- End Ticket Box 42623601 -->
    </div>
  </main>
</Layout>
