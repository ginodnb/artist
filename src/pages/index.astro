---
import Layout from '@layouts/Layout.astro';
// Header intentionally not included on this page because Hero handles top-of-page content
import { links, profile, event, ctas } from '@data/data';
import HeroEvent from '@components/HeroEvent.astro';
import LinkComponent from '@components/LinkComponent.astro';
import Accordion from '@components/Accordion.astro';
import SignupForm from '@components/SignupForm.astro';
---

<Layout className='text-gray-900 dark:text-white'>

		<!-- Header removed — HeroEvent replaces the top banner -->
		<main class="flex flex-col gap-2 pb-20">

			<!-- Hero Event section added before the lists -->
			<HeroEvent name={profile.name} bio={profile.bio} profileImage={profile.image} profileImage320={profile.image320} profileImage800={profile.image800} title={event.title} location={event.location} emoji={event.emoji} date={event.date} description={event.description} cta={ctas.tourDates} />

		<section class="w-full max-w-[640px] mx-auto mt-4 px-4">
			<div class="rounded-xl bg-black bg-opacity-25 p-2 sm:p-4">
				<SignupForm />
			</div>
		</section>

		{links.map((link) => (
			<section class="w-full max-w-[640px] mx-auto mt-4 rounded-lg">
				{link.title === 'New music' ? (
					<div class="px-4">
						<Accordion title={link.title} items={link.items} />
					</div>
				) : (
					<>
						{ link.title ? <h2 class="text-3xl p-4 pb-0 mt-2 text-center font-bold tracking-wide">{link.title}</h2> : null }
						<ul class="flex flex-col gap-4 p-4">
							{link.items.map((item) => (
								<li>
									<LinkComponent href={item.href} image={item.image} title={item.title} />
								</li>
							))}
						</ul>
						{link.title === 'NEW STUFF 🔗' ? (
							<div class="px-4 pb-4">
								<a
									href="/cambridge"
									target="_blank"
									class="text-white transition-transform dark:bg-black300 dark:bg-opacity-6 duration-200 ease-in-out hover:scale-[1.05] origin-center flex flex-row items-center gap-4 p-4 rounded-lg bg-gray-900 shadow-md min-h-[88px]"
								>
									<span class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-lg bg-yellow-300/20 text-2xl font-black text-yellow-300">
										🎟️
									</span>
									<h3 class="text-xl tracking-wide overflow-wrap-anywhere">Cambridge</h3>
								</a>
							</div>
						) : null}
					</>
				)}
			</section>
		))}
	</main>

</Layout>
